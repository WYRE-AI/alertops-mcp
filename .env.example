# AlertOps API key (sent as the `APIKey` query parameter on every REST call).
# Generate one in AlertOps under Account Settings -> Configurations ->
# Integrations -> API. See README's Authentication section for the
# read-only-scoping confidence split.
# Used by stdio and by HTTP only when AUTH_MODE=env.
# The gateway-mode compose service does not load this. Do not add it to
# that service's environment or via env_file.
ALERTOPS_API_KEY=

# stdio (default) or http
# MCP_TRANSPORT=stdio

# Credential source for HTTP: env (process environment) or gateway (required
# X-AlertOps-Api-Key header on each /mcp request). The container image and
# Compose default to gateway. Stdio ignores this and reads ALERTOPS_API_KEY.
# AUTH_MODE=env

# Required to start the HTTP transport. Leave this empty here.
# Generate a value with: openssl rand -hex 32
# The process logs an error and exits non-zero when this is empty or a known
# placeholder (so a copied example cannot forge X-Gateway-S2S). Compose will
# not start when it is unset. Never commit a real secret. The value is never logged.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without CONDUIT_S2S_SECRET.
# The server logs a warning, does not check X-Gateway-S2S, and binds 127.0.0.1
# only. A wider MCP_HTTP_HOST such as 0.0.0.0 is ignored in that mode.
# A known placeholder secret is still rejected.
# MCP_ALLOW_INSECURE_DEV=1

# Bind address. When MCP_HTTP_HOST is unset, the HTTP server binds 127.0.0.1.
# A configured CONDUIT_S2S_SECRET honors this value. The container image sets 0.0.0.0.
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8080

# LOG_LEVEL=info
